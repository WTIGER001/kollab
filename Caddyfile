{$DOMAIN:kollab.bauerstuff.com} {
    # Proxy API and WebSocket connections to the Go backend container
    # (Caddy automatically handles WebSocket connection upgrading out of the box)
    handle /api/* {
        reverse_proxy {
            dynamic a go-backend 8080 {
                refresh 5s
                versions ipv4
            }
            lb_policy round_robin
            lb_try_duration 5s
            fail_duration 10s
            max_fails 1
        }
    }

    # Serve the React frontend static build for all other routes
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}

# Kavita (Default internal port: 5000)
kavita.bauerstuff.com {
    reverse_proxy host.docker.internal:5000
}

# Audiobookshelf (Default internal port: 13378)
audiobookshelf.bauerstuff.com {
    reverse_proxy host.docker.internal:13378
}

# MyStuff (Host systemd binary on port 8083)
mystuff.bauerstuff.com {
    reverse_proxy host.docker.internal:8083
}

# Mythos Studio (Host systemd binary on port 8765)
myth.bauerstuff.com {
    reverse_proxy host.docker.internal:8765
}

# Sarah's ACT Prep (Host systemd binary on port 8088)
act.bauerstuff.com {
    reverse_proxy host.docker.internal:8088
}
